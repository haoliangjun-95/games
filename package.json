{
  "name": "puzzle-games-hub",
  "private": true,
  "version": "1.0.0",
  "description": "智益游戏中心 —— 面向初中生的 8 款离线益智小游戏（网页版 + Windows exe）",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:web": "vite build",
    "build:offline": "vite build --mode offline && node scripts/clean-offline.mjs",
    "build:all": "npm run build && npm run build:offline",
    "preview": "vite preview",
    "test": "vitest run",
    "trim:idiom": "node scripts/trim-idiom.mjs",
    "electron:dev": "concurrently -k \"vite build --watch --mode offline\" \"wait-on dist-offline/index.html && electron .\"",
    "electron:build:win": "npm run build:offline && electron-builder --win"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "concurrently": "^10.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0",
    "wait-on": "^9.5.0"
  }
}
